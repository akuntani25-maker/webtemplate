{
  "version": "0.2.0",
  "configurations": [
    {
      // Cara paling andal untuk debug NestJS: task menjalankan watch + inspector,
      // lalu debugger menempel. Breakpoint tetap hidup saat kode di-reload.
      "name": "Attach: API (NestJS)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "preLaunchTask": "dev: api (debug)",
      "cwd": "${workspaceFolder}/apps/api",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "sourceMaps": true
    },
    {
      // Alternatif tanpa watch: jalankan langsung dari TypeScript.
      "name": "Launch: API (ts-node, tanpa watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeArgs": ["-r", "ts-node/register", "-r", "tsconfig-paths/register"],
      "program": "${workspaceFolder}/apps/api/src/main.ts",
      "envFile": "${workspaceFolder}/apps/api/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      // Debug kode Next.js yang jalan di server (Server Component, route handler).
      "name": "Debug: Web server-side",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": { "NODE_OPTIONS": "--inspect" },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      // Debug kode yang jalan di browser (Client Component, event handler).
      // Jalankan dev server lebih dulu (task "dev: web").
      "name": "Debug: Web client-side (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "turbopack://[project]/*": "${webRoot}/*"
      }
    },
    {
      "name": "Debug: Jest file aktif",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "--runTestsByPath", "${relativeFile}"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug: Jest semua test (API)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "args": ["--runInBand"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      // Satu tombol: debug backend + frontend sekaligus.
      "name": "Debug: Full stack (API + Web)",
      "configurations": ["Attach: API (NestJS)", "Debug: Web server-side"],
      "stopAll": true
    }
  ]
}

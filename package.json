{
  "name": "digitemplate-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace produk digital (template website, spreadsheet, Notion, Canva, dsb).",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @digitemplate/api run start:dev",
    "dev:web": "npm --workspace @digitemplate/web run dev",
    "build": "npm-run-all build:api build:web",
    "build:api": "npm --workspace @digitemplate/api run build",
    "build:web": "npm --workspace @digitemplate/web run build",
    "lint": "npm-run-all --parallel lint:*",
    "lint:api": "npm --workspace @digitemplate/api run lint",
    "lint:web": "npm --workspace @digitemplate/web run lint",
    "test": "npm --workspace @digitemplate/api run test",
    "prisma:generate": "npm --workspace @digitemplate/api run prisma:generate",
    "prisma:migrate": "npm --workspace @digitemplate/api run prisma:migrate",
    "prisma:seed": "npm --workspace @digitemplate/api run prisma:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "typecheck": "npm-run-all --parallel typecheck:*",
    "typecheck:api": "npm --workspace @digitemplate/api run typecheck",
    "typecheck:web": "npm --workspace @digitemplate/web run typecheck",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1"
  },
  "//overrides": "Radix UI menarik @types/react@18 secara transitif; paksa v19 agar tipe React tidak terduplikasi (React 19 / Next 16).",
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

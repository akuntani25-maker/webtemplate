# ===== App =====
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# URL frontend yang diizinkan (CORS), pisahkan koma untuk beberapa origin
WEB_ORIGIN=http://localhost:3000

# ===== Database (Supabase / Postgres) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digitemplate?schema=public

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900          # detik (15 menit)
JWT_REFRESH_TTL=604800      # detik (7 hari)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false         # true di produksi (HTTPS)

# ===== Cloudflare R2 (S3-compatible) =====
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digitemplate
R2_PUBLIC_BASE_URL=          # opsional untuk aset publik
DOWNLOAD_URL_TTL=600         # detik (10 menit)
DOWNLOAD_MAX_PER_LICENSE=5

# ===== Email =====
MAIL_PROVIDER=console        # console | smtp | resend
MAIL_FROM="DigiTemplate <no-reply@digitemplate.id>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ===== Payment (manual fase 1) =====
BANK_NAME=BCA
BANK_ACCOUNT_NUMBER=1234567890
BANK_ACCOUNT_HOLDER=PT DigiTemplate
INVOICE_EXPIRY_HOURS=24

# ===== Security =====
THROTTLE_TTL=60
THROTTLE_LIMIT=100

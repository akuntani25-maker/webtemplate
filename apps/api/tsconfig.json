{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // rootDir dikunci ke src agar output = dist/main.js (bukan dist/src/main.js).
    // prisma/seed.ts dijalankan via ts-node, di-typecheck lewat tsconfig.typecheck.json.
    "rootDir": "./src",
    "baseUrl": "./",
    // Cache inkremental disimpan DI DALAM dist agar siklus hidupnya sejalan
    // dengan output. Bila di luar dist, menghapus dist membuat build "sukses"
    // tanpa menghasilkan file (cache mengira output masih ada).
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
